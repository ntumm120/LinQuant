diff --git a/ssdi8/triton/fp16_ssd_ops.py b/ssdi8/triton/fp16_ssd_ops.py
new file mode 100644
index 0000000..9ab9393
--- /dev/null
+++ b/ssdi8/triton/fp16_ssd_ops.py
@@ -0,0 +1,200 @@
+"""
+FP16 reference implementations of SSD sub-operations for precision ablation.
+
+These are PyTorch-level wrappers that correctly handle SSDi8's INT8 scale
+conventions. They DON'T modify any existing Triton kernels — they just provide
+alternative implementations that can be swapped in via module-level flags in
+quant_ssd_combined.py.
+
+Each function takes the SAME inputs as its INT8 counterpart and produces
+outputs compatible with the NEXT stage in the pipeline.
+"""
+
+import torch
+from einops import rearrange
+
+
+@torch.no_grad()
+def fp16_state_passing(states_int8, state_scale_hp, dA_chunk_cumsum,
+                       initial_states=None, seq_idx=None, chunk_size=None,
+                       out_dtype=torch.float16):
+    """FP16 state passing — replaces Q0.7 fixedpoint.
+
+    Takes INT8 states from _quant_chunk_state_fwd, dequantizes them,
+    runs the recurrence in FP32, and returns FP16 states + scales for
+    downstream chunk_scan to dequantize.
+
+    Args:
+        states_int8: (batch, nchunks, nheads, headdim*dstate) INT8 from chunk_state
+        state_scale_hp: (nheads, headdim) per-(H,P) state scales
+        dA_chunk_cumsum: (batch, nheads, nchunks) last cumsum per chunk
+        initial_states: (batch, nheads, headdim*dstate) or None
+    Returns:
+        states_int8: (batch, nchunks, nheads, dim) INT8 — requantized for chunk_scan
+        final_states: (batch, nheads, dim) INT8
+    """
+    batch, nchunks, nheads, dim = states_int8.shape
+    device = states_int8.device
+
+    # Dequantize states: int8 → float using state_scale
+    # state_scale_hp is (H, P), states are (batch, nchunks, H, P*N) flattened
+    # We need to figure out headdim and dstate from dim and scale shape
+    headdim = state_scale_hp.shape[-1]
+    dstate = dim // headdim
+
+    # Reshape for dequant: (batch, nchunks, H, P, N)
+    s_reshaped = states_int8.view(batch, nchunks, nheads, headdim, dstate).float()
+    scale = state_scale_hp.float().to(device)  # (H, P)
+    # Dequant: value = int8_val * scale[h, p]
+    s_fp = s_reshaped * scale[None, None, :, :, None]  # broadcast over batch, chunk, dstate
+
+    # Flatten back to (batch, nchunks, nheads, dim)
+    s_fp = s_fp.reshape(batch, nchunks, nheads, dim)
+
+    # Dequant initial states if present
+    init_fp = None
+    if initial_states is not None:
+        init_reshaped = initial_states.view(batch, nheads, headdim, dstate).float()
+        init_fp = (init_reshaped * scale[None, :, :, None]).reshape(batch, nheads, dim)
+
+    # Run recurrence in FP32
+    out_fp = torch.empty_like(s_fp, dtype=torch.float32)
+    if init_fp is not None:
+        running = init_fp.clone()
+    else:
+        running = torch.zeros(batch, nheads, dim, device=device, dtype=torch.float32)
+
+    for c in range(nchunks):
+        gate = torch.exp(dA_chunk_cumsum[:, :, c]).unsqueeze(-1)  # (batch, nheads, 1)
+        new_state = s_fp[:, c]  # (batch, nheads, dim)
+        running = gate * running + new_state
+        out_fp[:, c] = running
+
+    final_fp = running
+
+    # Requantize to INT8 for downstream chunk_scan (which expects INT8 states)
+    # Use same state_scale for requant
+    out_reshaped = out_fp.view(batch, nchunks, nheads, headdim, dstate)
+    inv_scale = 1.0 / scale.clamp(min=1e-12)  # (H, P)
+    out_scaled = out_reshaped * inv_scale[None, None, :, :, None]
+    out_int8 = out_scaled.round().clamp(-127, 127).to(torch.int8)
+    out_int8 = out_int8.reshape(batch, nchunks, nheads, dim)
+
+    final_reshaped = final_fp.view(batch, nheads, headdim, dstate)
+    final_scaled = final_reshaped * inv_scale[None, :, :, None]
+    final_int8 = final_scaled.round().clamp(-127, 127).to(torch.int8)
+    final_int8 = final_int8.reshape(batch, nheads, dim)
+
+    return out_int8, final_int8
+
+
+@torch.no_grad()
+def fp32_state_passing_dequant(states_int8, state_scale_hp, dA_chunk_cumsum,
+                                initial_states_int8=None):
+    """Proper FP32 state passing: dequant → FP32 recurrence → requant.
+
+    Unlike int8_state_passing_fp32_arith which operates on raw INT8 values,
+    this function dequantizes states to their true FP32 magnitudes using the
+    calibrated state scale, accumulates in FP32 (matching our pipeline's
+    approach), and re-quantizes using the same scale for chunk_scan.
+
+    Args:
+        states_int8: (batch, nchunks, nheads, headdim*dstate) INT8
+        state_scale_hp: (nheads, headdim) per-(H,P) state scales
+        dA_chunk_cumsum: (batch, nheads, nchunks) last cumsum per chunk
+        initial_states_int8: (batch, nheads, headdim*dstate) INT8 or None
+    Returns:
+        out_int8: (batch, nchunks, nheads, dim) INT8
+        final_int8: (batch, nheads, dim) INT8
+    """
+    batch, nchunks, nheads, dim = states_int8.shape
+    device = states_int8.device
+    headdim = state_scale_hp.shape[-1]
+    dstate = dim // headdim
+
+    # Build per-element scale: (H, P) → (H, P*N) by repeating along N
+    # states are stored as (batch, nchunks, H, P*N) where P*N = headdim*dstate
+    scale_hp = state_scale_hp.float().to(device)  # (H, P)
+    scale_flat = scale_hp.unsqueeze(-1).expand(-1, -1, dstate).reshape(nheads, dim)
+    # scale_flat: (H, P*N) — broadcast over batch, chunk
+
+    # Dequantize all chunk states to FP32
+    states_fp = states_int8.float() * scale_flat[None, None, :, :]  # (B, C, H, P*N)
+
+    # Dequantize initial states
+    if initial_states_int8 is not None:
+        running = initial_states_int8.float() * scale_flat[None, :, :]  # (B, H, P*N)
+    else:
+        running = torch.zeros(batch, nheads, dim, device=device, dtype=torch.float32)
+
+    # FP32 recurrence — accumulator stays in full precision
+    # Output convention matches Q0.7: out[c] = state ENTERING chunk c
+    #   out[0] = initial_state (before any recurrence)
+    #   out[c] = gate * out[c-1] + chunk_states[c-1]  (result after processing chunk c-1)
+    # chunk_scan reads prev_states[c] as the state entering chunk c.
+    inv_scale = (1.0 / scale_flat.clamp(min=1e-12))  # (H, P*N)
+    out_int8 = torch.empty_like(states_int8)
+
+    # Store initial state as out[0]
+    out_int8[:, 0] = (running * inv_scale[None]).round().clamp(-127, 127).to(torch.int8)
+
+    for c in range(nchunks):
+        gate = torch.exp(dA_chunk_cumsum[:, :, c]).unsqueeze(-1)  # (B, H, 1)
+        running = gate * running + states_fp[:, c]
+        if c < nchunks - 1:
+            out_int8[:, c + 1] = (running * inv_scale[None]).round().clamp(-127, 127).to(torch.int8)
+
+    final_int8 = (running * inv_scale[None]).round().clamp(-127, 127).to(torch.int8)
+
+    return out_int8, final_int8
+
+
+@torch.no_grad()
+def int8_state_passing_fp32_arith(states_int8, dA_chunk_cumsum,
+                                   initial_states_int8=None):
+    """FP32-arithmetic state passing on INT8 states.
+
+    Matches Q0.7 kernel structure exactly:
+    - s32 accumulates WITHOUT clamping between iterations (like Q0.7's INT32 accum)
+    - out[0] = clamp(initial_state) (stored before loop, like Q0.7 line 76-77)
+    - Loop: s32 = gate * s32 + new_state, then clamp to INT8 for output only
+    - Only difference: gate * s32 uses FP32 multiply instead of fixedpoint shift
+
+    Args:
+        states_int8: (batch, nchunks, nheads, dim) INT8 — from chunk_state (reshaped)
+        dA_chunk_cumsum: (batch, nheads, nchunks) — last cumsum value per chunk
+        initial_states_int8: (batch, nheads, dim) INT8 or None
+    Returns:
+        out_int8: (batch, nchunks, nheads, dim) INT8
+        final_int8: (batch, nheads, dim) INT8
+    """
+    batch, nchunks, nheads, dim = states_int8.shape
+    device = states_int8.device
+
+    out = torch.empty(batch, nchunks, nheads, dim, device=device, dtype=torch.int8)
+
+    # Initialize s32 accumulator (matches Q0.7 kernel lines 68-73)
+    if initial_states_int8 is not None:
+        s32 = initial_states_int8.float()  # (batch, nheads, dim) — NOT clamped
+    else:
+        s32 = torch.zeros(batch, nheads, dim, device=device, dtype=torch.float32)
+
+    # Store first output = clamp(s32) BEFORE loop (matches Q0.7 kernel lines 76-77)
+    out[:, 0] = s32.round().clamp(-127, 127).to(torch.int8)
+
+    # Loop: process chunks (matches Q0.7 kernel lines 81-116)
+    for c in range(nchunks):
+        new_s = states_int8[:, c].float()  # (batch, nheads, dim)
+        gate = torch.exp(dA_chunk_cumsum[:, :, c]).unsqueeze(-1)  # (batch, nheads, 1)
+
+        # FP32 gate multiply (vs Q0.7: (s32 * gate_q + S//2) >> SHIFT)
+        # s32 stays in FP32 — NOT clamped between iterations
+        s32 = gate * s32 + new_s
+
+        # Store clamped output (but s32 itself stays unclamped)
+        if c < nchunks - 1:
+            out[:, c + 1] = s32.round().clamp(-127, 127).to(torch.int8)
+
+    # Final state
+    final = s32.round().clamp(-127, 127).to(torch.int8)
+    return out, final
diff --git a/vllm_kernel_patch.py b/vllm_kernel_patch.py
new file mode 100755
index 0000000..607b295
--- /dev/null
+++ b/vllm_kernel_patch.py
@@ -0,0 +1,74 @@
+"""Replace SSDi8's Marlin QQQ W4A8 kernel with vLLM's version.
+
+Import this BEFORE loading the quantized model. It monkey-patches
+quant_linear_cuda.w4a8o16_gemm to use vLLM's marlin_qqq_gemm. Upstream SSDi8's QQQ kernel
+has a shared-memory hazard that produces wrong results on SM 9.0 (H100); vLLM's copy is
+fixed. Both SSDi8's and LinQuant's W4A8 linears then run the same GEMM.
+"""
+
+import os
+import sys
+
+import torch
+
+# This file lives in `libs/SSDi8/` of the LinQuant repo.
+_REPO = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
+
+# vLLM's marlin_qqq kernel, built as a standalone extension: `cd csrc/marlin_qqq && pip install .`
+# or `python setup.py build_ext --inplace` (then MARLIN_QQQ_DIR or the default dir below).
+sys.path.insert(0, os.environ.get("MARLIN_QQQ_DIR", os.path.join(_REPO, "csrc", "marlin_qqq")))
+import marlin_qqq
+
+# SSDi8's compiled quant_linear_cuda (the module whose function we replace).
+sys.path.insert(0, os.path.join(_REPO, "libs", "SSDi8"))
+import quant_linear_cuda
+
+# Fused FP16->INT8 quantizer (one Triton kernel, FP32 internally, IEEE round-to-nearest divide).
+from linquant.w4a8_linear import _fused_fp16_to_int8
+
+
+def _vllm_w4a8o16_gemm(
+    x, weight, input_scale, s_channel, s_group, workspace, size_m, size_n, size_k, output_transpose
+):
+    """Drop-in replacement using vLLM's marlin_qqq_gemm."""
+    # SSDi8's kernel takes FP16 x and does INT8 quant internally.
+    # vLLM's kernel takes INT8 x directly.
+    # So we need to quantize x to INT8 here.
+    if x.dtype != torch.int8:
+        if input_scale.numel() == 1:
+            # Per-tensor scale. SSDi8's native kernel quantizes FP16→INT8 inside
+            # CUDA; vLLM's takes INT8, so the conversion happens here. Doing it
+            # with elementwise torch ops costs ~5 full passes over x in FP32
+            # (67 MB → 134 MB per pass at prefill shapes) and measured
+            # +795 us/layer on Mamba-2 1.3B, B=8, T=2048 — see
+            # docs/audit/04_inefficiencies.md I-2. The fused Triton kernel is
+            # bit-exact with the chain it replaces.
+            scale = input_scale.float().clamp(min=1e-12)
+            x_2d = x.reshape(-1, x.shape[-1])
+            x_q = _fused_fp16_to_int8(x_2d, scale, clamp_min=-128.0, reciprocal=False)
+            x_q = x_q.view(x.shape)
+            s_tok = scale.expand(x.shape[0]).contiguous()
+        else:
+            # Per-token scale
+            scale = x.abs().amax(dim=-1, keepdim=True).float() / 127.0
+            scale = scale.clamp(min=1e-12)
+            x_q = (x.float() / scale).round().clamp(-128, 127).to(torch.int8)
+            s_tok = scale.squeeze(-1).contiguous()
+    else:
+        x_q = x
+        s_tok = (
+            input_scale.expand(x.shape[0]) if input_scale.numel() == 1 else input_scale
+        ).contiguous()
+
+    out = marlin_qqq.marlin_qqq_gemm(
+        x_q, weight, s_tok, s_channel, s_group, workspace, size_m, size_n, size_k
+    )
+
+    if output_transpose:
+        out = out.t().contiguous()
+
+    return out
+
+
+quant_linear_cuda.w4a8o16_gemm = _vllm_w4a8o16_gemm
+print("[vllm_kernel_patch] Replaced w4a8o16_gemm with vLLM's marlin_qqq_gemm")
